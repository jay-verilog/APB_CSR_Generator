    <Register_SPI_BAUD_RATE_REGISTER
        Reg_name        = "BAUD_RATE_REGISTER"
        offset_addr     = "'h2"
        reset           = "32'h0"
        reg_description = "">
        
        <Vector_Field
            field_name        = "SPPR"
            access_type       = "wr"
            bit_position      = "6 - 4"
