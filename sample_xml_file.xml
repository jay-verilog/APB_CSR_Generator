<Register_Map>
    <block_name     block_name = ""> </data_width>  <!-- block should in lower_case -->
    <data_width     data_width = ""> </data_width>
    <address_width  addr_width = ""> </address_width>
    <register_width reg_width  = ""> </register_width>
   
<!--  APB INTERFACE INPUT/OUTPUT PORT DECLARTION -->   
<!--  If you don't want I/O, You can remove it-->
    <apb_extra_input>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
    </apb_extra_input>

    <apb_extra_output>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
    </apb_extra_output>

<!--  Top Block INPUT/OUTPUT PORT DECLARTION -->
<!--  If you don't want I/O, You can remove it-->
    <top_block_extra_input>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
        <Field input = ""  width = ""/>
    </top_block_extra_input>

    <top_block_extra_output>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
    </top_block_extra_output>

    <top_block_extra_inout>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
        <Field output = "" width = ""/>
    </top_block_extra_output>


<!-- Register Map -->
    <Register_NAME
        name    = "NAME1"   
        address = "'h"
        reset   = "'h"
        wr      = "">   <!-- "wr" = wirte and read. "r" = read only. "w" = write only  -->
        <Field name = ""   bits="3'b111"/>
        <Field name = ""   bits="3'b110"/>
        <Field name = ""   bits="3'b101"/>
        <Field name = ""   bits="3'b100"/>
        <Field name = ""   bits="3'b011"/>
        <Field name = ""   bits="3'b010"/>
        <Field name = ""   bits="3'b001"/>
        <Field name = ""   bits="3'b000"/>
    </Register_NAME>



</Register_Map>


