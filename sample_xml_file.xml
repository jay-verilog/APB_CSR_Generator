

<Register_Map>
<block_name     block_name = ""> </block_name>  <!-- block name should be lower_case -->
<data_width     data_width = "32"> </data_width>
<address_width  addr_width = ""> </address_width>
<register_width reg_width  = "32"> </register_width>

<!-- Register map: duplicate this block for every register you need.
    "wr" = "wr" (read/write), "r" (read only).
    Don't define reversed bits-->

    <Register_NAME
        name        = "NAME"
        address     = "" 
        reset       = "32'h0"
        wr          = "wr">
        
        <Field bit_name = "FIELD31" bit_position = "'h1F"/>
        <Field bit_name = "FIELD30" bit_position = "'h1E"/>
        <Field bit_name = "FIELD29" bit_position = "'h1D"/>
        <Field bit_name = "FIELD28" bit_position = "'h1C"/>
        <Field bit_name = "FIELD27" bit_position = "'h1B"/>
        <Field bit_name = "FIELD26" bit_position = "'h1A"/>
        <Field bit_name = "FIELD25" bit_position = "'h19"/>
        <Field bit_name = "FIELD24" bit_position = "'h18"/>
        <Field bit_name = "FIELD23" bit_position = "'h17"/>
        <Field bit_name = "FIELD22" bit_position = "'h16"/>
        <Field bit_name = "FIELD21" bit_position = "'h15"/>
        <Field bit_name = "FIELD20" bit_position = "'h14"/>
        <Field bit_name = "FIELD19" bit_position = "'h13"/>
        <Field bit_name = "FIELD18" bit_position = "'h12"/>
        <Field bit_name = "FIELD17" bit_position = "'h11"/>
        <Field bit_name = "FIELD16" bit_position = "'h10"/>
        <Field bit_name = "FIELD15" bit_position = "'hF"/>
        <Field bit_name = "FIELD14" bit_position = "'hE"/>
        <Field bit_name = "FIELD13" bit_position = "'hD"/>
        <Field bit_name = "FIELD12" bit_position = "'hC"/>
        <Field bit_name = "FIELD11" bit_position = "'hB"/>
        <Field bit_name = "FIELD10" bit_position = "'hA"/>
        <Field bit_name = "FIELD09" bit_position = "'h9"/>
        <Field bit_name = "FIELD08" bit_position = "'h8"/>
        <Field bit_name = "FIELD07" bit_position = "'h7"/>
        <Field bit_name = "FIELD06" bit_position = "'h6"/>
        <Field bit_name = "FIELD05" bit_position = "'h5"/>
        <Field bit_name = "FIELD04" bit_position = "'h4"/>
        <Field bit_name = "FIELD03" bit_position = "'h3"/>
        <Field bit_name = "FIELD02" bit_position = "'h2"/>
        <Field bit_name = "FIELD01" bit_position = "'h1"/>
        <Field bit_name = "FIELD00" bit_position = "'h0"/>
    </Register_NAME>

</Register_Map>



