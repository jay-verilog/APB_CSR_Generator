
<Register_Map>
<block_name     block_name = ""> </block_name>  <!-- block name should be lower_case -->
<data_width     data_width = "32"> </data_width>
<address_width  addr_width = ""> </address_width>
<register_width reg_width  = "32"> </register_width>

<!-- Register map: duplicate this block for every register you need.
    "wr" = "wr" (read/write), "r" (read only).
    Don't define reversed bit/bits
    -->

    <Register_NAME
        name        = "NAME"
        address     = "" 
        reset       = "32'h0"
        wr          = "wr"
        >

        <Field name = "FIELD31" bit_addr = "'h1F"/>
        <Field name = "FIELD30" bit_addr = "'h1E"/>
        <Field name = "FIELD29" bit_addr = "'h1D"/>
        <Field name = "FIELD28" bit_addr = "'h1C"/>
        <Field name = "FIELD27" bit_addr = "'h1B"/>
        <Field name = "FIELD26" bit_addr = "'h1A"/>
        <Field name = "FIELD25" bit_addr = "'h19"/>
        <Field name = "FIELD24" bit_addr = "'h18"/>
        <Field name = "FIELD23" bit_addr = "'h17"/>
        <Field name = "FIELD22" bit_addr = "'h16"/>
        <Field name = "FIELD21" bit_addr = "'h15"/>
        <Field name = "FIELD20" bit_addr = "'h14"/>
        <Field name = "FIELD19" bit_addr = "'h13"/>
        <Field name = "FIELD18" bit_addr = "'h12"/>
        <Field name = "FIELD17" bit_addr = "'h11"/>
        <Field name = "FIELD16" bit_addr = "'h10"/>
        <Field name = "FIELD15" bit_addr = "'hF"/>
        <Field name = "FIELD14" bit_addr = "'hE"/>
        <Field name = "FIELD13" bit_addr = "'hD"/>
        <Field name = "FIELD12" bit_addr = "'hC"/>
        <Field name = "FIELD11" bit_addr = "'hB"/>
        <Field name = "FIELD10" bit_addr = "'hA"/>
        <Field name = "FIELD09" bit_addr = "'h9"/>
        <Field name = "FIELD08" bit_addr = "'h8"/>
        <Field name = "FIELD07" bit_addr = "'h7"/>
        <Field name = "FIELD06" bit_addr = "'h6"/>
        <Field name = "FIELD05" bit_addr = "'h5"/>
        <Field name = "FIELD04" bit_addr = "'h4"/>
        <Field name = "FIELD03" bit_addr = "'h3"/>
        <Field name = "FIELD02" bit_addr = "'h2"/>
        <Field name = "FIELD01" bit_addr = "'h1"/>
        <Field name = "FIELD00" bit_addr = "'h0"/>
    </Register_NAME>

</Register_Map>



